{
  "manifest_version": 3,
  "name": "OpenFront Attack Radar",
  "version": "0.1.0",
  "description": "Predicts when Nation/Tribe bots will next decide whether to attack, and highlights their likely target.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://openfront.io/*",
        "*://*.openfront.io/*",
        "*://*.openfront.dev/*",
        "http://localhost:9000/*"
      ],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
